# Optional override; default is the data directory beside config.py.
# Automatically read from project .env. Shell variables override file values.
INCIDENT_DATA_DIR=./data
# The default mock needs no API keys or network access.
MEMORY_BACKEND=mock
# Set MEMORY_BACKEND=hindsight only after configuring a running service.
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_BANK_ID=adaptive-incident-intelligence
HINDSIGHT_API_KEY=
HINDSIGHT_TIMEOUT=120

# Docker-free persistent alternative (set MEMORY_BACKEND=sqlite to enable).
SQLITE_PATH=./.runtime/incidents.sqlite3
# Durable approvals and audit history. Mount this path as a Docker volume.
WORKFLOW_DB_PATH=./.runtime/workflows.sqlite3

# simulation is the safe default. connector calls one administrator-configured sandbox service.
ACTION_BACKEND=simulation
CONNECTOR_BASE_URL=http://127.0.0.1:9000
CONNECTOR_API_KEY=
CONNECTOR_TIMEOUT=30
CONNECTOR_RECEIPT_DB_PATH=./.runtime/connector-receipts.sqlite3

# none = deterministic rules; ollama = local model with explicit error fallback.
LLM_PROVIDER=none
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:9b
LLM_TIMEOUT=120
LLM_CONTEXT=8192
LLM_MAX_TOKENS=1200

# Comma-separated browser origins allowed to call the local API.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_UPLOAD_MAX_BYTES=5242880
