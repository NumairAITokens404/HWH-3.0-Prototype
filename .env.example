# Optional override; default is the data directory beside config.py.
# Set these values in your shell. The application does not load .env files.
INCIDENT_DATA_DIR=./data
# The default mock needs no API keys or network access.
MEMORY_BACKEND=mock
# Set MEMORY_BACKEND=hindsight only after configuring a running service.
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_BANK_ID=adaptive-incident-intelligence
HINDSIGHT_API_KEY=
HINDSIGHT_TIMEOUT=120
